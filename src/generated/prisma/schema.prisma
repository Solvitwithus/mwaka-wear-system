// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(uuid())
  userName               String                  @unique
  password               String
  firstName              String
  lastName               String
  shortName              String
  address                String
  email                  String                  @unique
  roleId                 String
  branch                 String
  phone1                 String
  phone2                 String
  performanceEvaluations PerformanceEvaluation[]
  description            String?                 @default("No description")
  role                   Role                    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  messages               Message[]
  profile                Profile?
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?      @default("No description")
  permissions Permission[]
  users       User[]
}

model Permission {
  id     String  @id @default(uuid())
  name   String
  value  Boolean @default(false)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId String
}

model Message {
  id        String   @id @default(uuid())
  file      String?
  chat      String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id             String   @id @default(uuid())
  profileName    String
  profileAbout   String
  profilePicture String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Currency {
  id                     String  @id @default(uuid())
  currencyName           String
  currencySymbol         String
  currencyCode           String
  currencyFormat         String
  decimalPlaces          String
  thousandSeparator      String
  KSHtoUSDExchange       String
  allowedforTransactions Boolean
}

model BankName {
  id String @id @default(uuid())

  bankCode          String  @unique
  bankName          String
  branchName        String
  branchCode        String  @unique
  BICCode           String
  headOfficeAddress String
  country           String
  email             String  @unique
  phone1            String
  phone2            String
  website           String
  status            Boolean @default(false)
  addedBy           String
  bankType          String
  remarks           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Salesperson {
  id              String  @id @default(uuid())
  salesCode       String  @unique
  employeeCode    String  @unique @default("") // Default to empty string
  firstName       String
  lastName        String
  gender          String  @default("") // Default to empty string
  phone           String  @unique
  phone2          String?
  email           String  @unique
  address         String  @default("") // Default to empty string
  region          String  @default("") // Default to empty string
  country         String  @default("") // Default to empty string
  idNumber        String  @default("") // Default to empty string
  salesArea       String  @default("") // Default to empty string
  salesType       String  @default("") // Default to empty string
  branchOffice    String  @default("") // Default to empty string
  status          String  @default("Active")
  employmentType  String  @default("") // Default to empty string
  supervisor      String  @default("") // Default to empty string
  salesTarget     Float   @default(0) // Default to 0
  salesCommission Float   @default(0) // Default to 0
  allowDiscount   Boolean @default(false)
  addedBy         String  @default("") // Default to empty string
  remarks         String?

  salesEntries SalesEntry[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Branch {
  id            String   @id @default(uuid())
  branchCode    String   @unique
  name          String
  region        String
  town          String
  address       String
  phone         String
  email         String
  manager       String
  status        Boolean
  cycleDuration String
  remarks       String
  addedBy       String
  createdAt     DateTime @default(now())
}

model SalesArea {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  region       String
  county       String
  zone         String
  headquarters String
  areaManager  String
  phone        String
  email        String
  status       Boolean  @default(true)
  remarks      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PaymentTerm {
  id                      String   @id @default(cuid())
  name                    String
  description             String?
  totalDuration           Int
  numInstallments         Int
  installments            Json
  startDateRule           String
  gracePeriod             Int
  lateFeeEnabled          Boolean
  lateFeeType             String
  lateFeeAmount           Float
  lateFeeAfterDays        Int
  earlyDiscountEnabled    Boolean
  earlyDiscountPercent    Float
  earlyDiscountWithinDays Int
  allowedMethods          String
  applicableTo            String
  isActive                Boolean  @default(true)
  notes                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model PaymentMethod {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  description    String?
  supportedTypes String // e.g., ["Cash", "Card", "Mobile Money"]
  isActive       Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SalesCategory {
  id                  String  @id @default(uuid())
  code                String  @unique
  name                String
  description         String?
  priceAdjustmentType String // e.g., "percentage", "fixed"
  priceAdjustment     Float
  allowCredit         Boolean
  creditLimit         Float?
  defaultPaymentTerm  String? // Reference payment term name or ID if normalized
  applicableChannels  String // Comma-separated values like "online,retail"
  isActive            Boolean @default(true)
  remarks             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Driver {
  id               Int     @id @default(autoincrement())
  userName         String  @unique
  firstName        String
  lastName         String
  phoneNumber      String?
  email            String  @unique
  licenseNumber    String?
  licenseIssueDate String?
  dateOfBirth      String?
  address          String?
  remarks          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vehicle {
  id                     String                        @id @default(uuid())
  plateNumber            String
  make                   String
  model                  String
  yearOfManufacture      String
  status                 String
  fuelType               String
  capacity               String
  driver                 String
  assignedBranch         String
  purpose                String
  remarks                String
  initialOdometerReading String
  ownershipType          String
  generalLedgerAccounts  VehicleGeneralLedgerAccount[]
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
}

model Shift {
  id                  Int      @id @default(autoincrement())
  shiftName           String
  shiftCode           String   @unique
  startTime           String
  endTime             String
  shiftActiveDate     DateTime
  driver              String
  vehicle             String
  transportationItem  String
  startLocation       String
  endLocation         String
  wayPoint            String?
  isActive            String
  comment             String?
  customStartLocation String?
  customEndLocation   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VehicleCategory {
  id           Int     @id @default(autoincrement())
  categoryName String
  description  String
  type         String
  maxLoad      Float
  isActive     Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UnitOfMeasure {
  id               String   @id @default(uuid())
  unitName         String
  abbreviation     String
  description      String?
  conversionFactor Float
  isBaseUnit       Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model VehicleGeneralLedgerAccount {
  id               String   @id @default(uuid())
  glAccountCode    String   @unique
  glAccountName    String
  accountType      String // Enum is possible (e.g. Revenue, Expense, Asset, Liability)
  currencyCode     String
  description      String
  isActive         Boolean
  isDefault        Boolean
  isPrimaryAccount Boolean
  effectiveFrom    DateTime
  openingBalance   Float
  remarks          String
  vehicleId        String
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id])
  driverUserName   String
  licenseNumber    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ItemCategory {
  id            String   @id @default(uuid())
  categoryName  String
  categoryCode  String   @unique
  description   String?
  type          String
  unitOfMeasure String
  tags          String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Item {
  id                    Int      @id @default(autoincrement())
  code                  String   @unique // Unique item code
  name                  String // Item name
  category              String // Item category
  unitOfMeasure         String // Unit of measure (e.g., kg, piece)
  description           String? // Optional description
  excludeFromSale       Boolean  @default(false) // Whether the item is excluded from sales
  excludeFromPurchase   Boolean  @default(false) // Whether the item is excluded from purchases
  branch                String // Associated branch
  creator               String // Created by (user or system)
  status                String // e.g., "active", "inactive"
  barcode               String   @unique // Unique item barcode
  itemPrice             Float    @default(0) // Base price of the item (with tax)
  priceBeforeTax        Float    @default(0) // Price before tax
  taxAmount             Float    @default(0) // Tax value derived from taxType
  discountWholesale     Float    @default(0) // Discount for wholesale
  discountRetail        Float    @default(0) // Discount for retail
  customDiscountAllowed Boolean  @default(false) // Whether custom discounts are allowed
  taxType               String? // Optional tax type (e.g., VAT, None)
  createdAt             DateTime @default(now()) // Timestamp of creation
  updatedAt             DateTime @updatedAt // Timestamp of last update
}

model Tax {
  id               String   @id @default(uuid())
  name             String
  code             String   @unique
  description      String?
  chargeType       String // "Fixed" or "Percentage"
  lowerLimit       Float
  upperLimit       Float
  rate             Float
  fixedAmount      Float
  reliefApplicable Boolean
  effectiveFrom    DateTime
  branch           String
  creator          String
  status           String // "Active" or "Inactive"
  createdAt        DateTime @default(now())
}

model Client {
  id                    String   @id @default(uuid())
  customerName          String
  customerInitials      String
  address               String
  kraPin                String
  currency              String
  isActive              Boolean
  phone1                String
  phone2                String
  email                 String
  bankName              String
  accountNumber         String
  salesPerson           String
  discountEliginility   Boolean
  branchName            String
  salesArea             String
  salesType             String
  comment               String
  customerId            String
  preferedPaymentMethod String
  sex                   String
  allowedDiscount       String
  creditLimit           String
  paymentTerms          String
  refNo                 String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  salesQuotations SalesQuotation[]
  directSales     DirectSale[]
  salesEntry      SalesEntry[]
}

model QuotationItem {
  id          String         @id @default(uuid())
  quotation   SalesQuotation @relation(fields: [quotationId], references: [id])
  quotationId String

  itemId    String? // Add this if you're linking to a central item catalog
  itemName  String
  quantity  Int
  unitPrice Float
  discount  Float?
  tax       Float? // Optional: add this if you're using tax
  total     Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalesQuotation {
  id            String   @id @default(uuid())
  quotationDate DateTime @default(now())
  client        Client   @relation(fields: [clientId], references: [id])
  clientId      String

  deliveryDetails   DeliveryDetail @relation(fields: [deliveryDetailsId], references: [id])
  deliveryDetailsId String         @unique // ✅ Add this

  quotationItems QuotationItem[]

  subtotal   Float
  shipping   Float
  grandTotal Float
  remarks    String?
  status     String  @default("Pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeliveryDetail {
  id        String   @id @default(uuid())
  address   String
  shiftId   String
  driverId  String
  vehicleId String
  offload   Boolean? @default(false)
  prepay    Boolean? @default(false)

  deliveryDate DateTime

  // Optional additions based on frontend
  deliveryFrom      String?
  destination       String?
  customerReference String?
  comment           String?
  phoneNumber       String?
  accompaniedBy     String?

  salesQuotation SalesQuotation?
  directSale     DirectSale?
  salesEntry     SalesEntry?
}

model DirectSale {
  id       String   @id @default(uuid())
  saleDate DateTime @default(now())
  client   Client   @relation(fields: [clientId], references: [id])
  clientId String

  deliveryDetails   DeliveryDetail @relation(fields: [deliveryDetailsId], references: [id])
  deliveryDetailsId String         @unique

  saleItems DirectSaleItem[]

  subtotal   Float
  shipping   Float
  grandTotal Float
  remarks    String?
  status     String  @default("Completed")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DirectSaleItem {
  id           String     @id @default(uuid())
  directSale   DirectSale @relation(fields: [directSaleId], references: [id])
  directSaleId String

  itemId    String? // Optional: if referencing central catalog
  itemName  String
  quantity  Int
  unitPrice Float
  discount  Float?
  tax       Float?
  total     Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CreditStatus {
  id            String  @id @default(uuid())
  code          String  @unique
  statusName    String
  description   String
  category      String
  defaultStatus Boolean @default(false)
  isFinalStatus Boolean @default(false)
  isActive      Boolean @default(true)
  remarks       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BankAccount {
  id                    String   @id @default(uuid())
  bankName              String
  accountCode           String?  @unique
  accountName           String
  accountNumber         String   @unique
  accountType           String
  accountStatus         String   @default("Active")
  allowOverdraft        Boolean  @default(false)
  overdraftLimit        Float?
  isPrimaryAccount      Boolean  @default(false)
  usedForPayroll        Boolean  @default(false)
  branchCode            String?
  departmentName        String?
  currency              String
  effectiveFrom         DateTime
  openingBalance        Float
  reconciliationEnabled Boolean  @default(false)
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model SalesEntry {
  id       String   @id @default(uuid())
  saleDate DateTime @default(now())

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  deliveryDetails   DeliveryDetail @relation(fields: [deliveryDetailsId], references: [id])
  deliveryDetailsId String         @unique // Only keep this if 1:1 relation is required

  salesEntryItems SalesEntryItem[] // ✅ corrected from saleEntryItems
  salesperson     Salesperson      @relation(fields: [salespersonId], references: [id])
  salespersonId   String
  subtotal        Float
  shipping        Float
  grandTotal      Float
  remarks         String?
  status          String           @default("Completed")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalesEntryItem {
  id String @id @default(uuid())

  salesEntry   SalesEntry @relation(fields: [salesEntryId], references: [id]) // ✅ corrected field name
  salesEntryId String // ✅ corrected from saleEntryId

  itemId    String? // Optional: if referencing central catalog
  itemName  String
  quantity  Int
  unitPrice Float
  discount  Float?
  tax       Float?
  total     Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id                 String             @id @default(uuid())
  departmentName     String
  shortName          String
  description        String
  headOfDepartmentId String
  isActive           Boolean            @default(true)
  establishedDate    String
  budgetAmount       Float
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  designationTitles  DesignationTitle[]
}

model Rank {
  id                String             @id @default(uuid())
  rankName          String
  shortName         String
  description       String?
  rankLevel         Int
  isActive          Boolean            @default(true)
  createdDate       DateTime
  designationTitles DesignationTitle[]
}

model DesignationTitle {
  id           String     @id @default(uuid())
  titleName    String
  titleCode    String     @unique
  shortCode    String
  departmentId String
  rankId       String
  description  String
  isActive     Boolean    @default(true)
  isNew        Boolean    @default(false)
  salary       Float
  createdAt    DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id])
  rank         Rank       @relation(fields: [rankId], references: [id])
}

model SalesGroup {
  id                    String   @id @default(uuid())
  code                  String   @unique
  groupName             String
  groupType             String
  description           String?
  defaultCommissionRate Float
  allowCustomCommission Boolean
  discountAllowed       Float
  salesTarget           String?
  isActive              Boolean  @default(true)
  remarks               String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model VehicleExpenseCategory {
  id                   String   @id @default(uuid())
  name                 String
  code                 String   @unique
  description          String?
  expenseAccount       String
  tag                  String?
  isRecurring          Boolean  @default(false)
  appliesToAllVehicles Boolean  @default(false)
  amount               Float?
  effectiveFrom        DateTime
  isActive             Boolean  @default(true)
  remarks              String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model PrepaymentAllocation {
  id                String   @id @default(uuid())
  salesEntryId      String
  itemId            String
  total             Float
  allocateAll       Float    @default(0)
  partialAllocation Float    @default(0)
  balance           Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Supplier {
  id                     String             @id @default(cuid())
  code                   String             @unique
  name                   String
  shortName              String
  email                  String             @unique
  phone                  String
  phone2                 String?
  country                String
  county                 String
  town                   String
  address                String
  kra                    String
  vat                    String
  bankName               String
  bankCode               String?
  accountNumber          String
  preferredPaymentMethod String
  paymentTerm            String
  currency               String
  taxType                String
  creditLimit            Float
  isActive               Boolean            @default(true)
  blacklisted            Boolean            @default(false)
  remarks                String?
  website                String?
  purchaseRequisitions   PurchaseReQEntry[] @relation("SupplierPurchaseRequests")
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}

model PurchaseReQEntry {
  id         String  @id @default(uuid())
  grandTotal Float
  remarks    String?
  shipping   Float
  status     String
  subtotal   Float

  // Foreign key to Supplier
  supplierId String
  supplier   Supplier @relation("SupplierPurchaseRequests", fields: [supplierId], references: [id])

  // One-to-one relation
  purchaseAdditionalInfo   PurchaseAdditionalInfo?
  purchaseAdditionalInfoId String?

  // One-to-many relation
  items PurchaseRequisitionEntryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseRequisitionEntryItem {
  id        String @id @default(uuid())
  itemId    String
  itemName  String
  quantity  Int
  unitPrice Float
  discount  Float
  tax       Float
  total     Float

  purchaseReQEntryId String
  purchaseReQEntry   PurchaseReQEntry @relation(fields: [purchaseReQEntryId], references: [id])
}

model PurchaseAdditionalInfo {
  id          String   @id @default(uuid())
  comment     String?
  deliverTo   String
  dueDate     DateTime
  isUrgent    Boolean
  prepay      Boolean
  reqDate     DateTime
  offload     Boolean
  isDelivered Boolean

  purchaseReQEntry   PurchaseReQEntry? @relation(fields: [purchaseReQEntryId], references: [id])
  purchaseReQEntryId String?           @unique
}

model SupplierPaymentTracking {
  id              String   @id @default(uuid())
  purchaseEntryId String
  itemId          String
  totalAmount     Float
  allocatedAmount Float    @default(0)
  balance         Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Grade {
  id              String   @id @default(uuid())
  code            String   @unique
  gradeName       String
  description     String?
  qualityLevel    String
  materialQuality String
  condition       String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GradingSheet {
  id             String       @id @default(uuid())
  baleName       String
  baleWeight     Float
  branch         String
  comment        String?
  damageCount    Int
  damageWeight   Float
  gradeDate      DateTime
  gradeReference String
  grader         String
  itemCount      Int
  itemtoGrade    String?
  unpairedCount  Int
  workCenter     String
  status         String       @default("Thrift")
  // Relation to produced items
  itemsProduced  GradedItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GradedItem {
  id             String       @id @default(uuid())
  itemCode       String
  itemName       String
  grade          String
  quantity       Int
  qtyToHold      Int?
  sellingPrice   Float
  qtyToDispatch  Float        @default(0)
  // Foreign key
  gradingSheetId String
  gradingSheet   GradingSheet @relation(fields: [gradingSheetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PausedCart {
  id         String           @id @default(uuid())
  name       String
  branchName String
  userId     String
  items      PausedCartItem[]
  createdAt  DateTime         @default(now())
}

model PausedCartItem {
  id           String     @id @default(uuid())
  pausedCart   PausedCart @relation(fields: [pausedCartId], references: [id], onDelete: Cascade)
  pausedCartId String
  itemCode     String
  itemName     String
  price        Float
  qty          Int
  availableQty Int
}

model Payment {
  id              String   @id @default(cuid())
  amount          Float
  mpesaReceipt    String   @unique
  phoneNumber     String
  transactionTime DateTime
  status          String   @default("paid")
  createdAt       DateTime @default(now())
}

model Policy {
  id                    String   @id @default(cuid())
  policyTitle           String
  code                  String   @unique
  policyCategory        String
  effectiveDate         String
  purpose               String
  scope                 String
  policyRules           String
  consequences          String
  applicableDepartments String[] // Stored as string array
  applicableBranches    String[] // Stored as string array
  rolesAffected         String
  comment               String
  createdAt             DateTime @default(now())
}

model Trainer {
  id                String   @id @default(cuid())
  nationalId        String   @unique
  fullName          String
  email             String
  phone1            String
  phone2            String?
  website           String?
  gender            String
  specialization    String
  credentials       String[] // list of certifications
  experienceYears   Int
  languages         String[]
  trainerType       String
  availability      String
  ratePerSession    Float
  city              String
  country           String
  preferredMode     String
  canTravel         Boolean
  workingZones      String[]
  contractStartDate String
  contractEndDate   String
  status            String   @default("Active")
  trainerProfile    String?
  remarks           String?
  portfolioLinks    String[]
  addedBy           String
  createdAt         DateTime @default(now())
}

model WorkShift {
  id                String   @id @default(cuid())
  shiftCode         String   @unique
  shiftName         String
  startTime         String
  endTime           String
  days              String[] // e.g. ["Monday", "Wednesday", "Friday"]
  assignedEmployees String[] // e.g. list of employee IDs or usernames
  branch            String
  status            String // e.g. "Active", "Inactive"
  description       String
  addedBy           String
  remarks           String
  createdAt         DateTime @default(now())
}

model Holiday {
  id                 String   @id @default(cuid())
  holidayCode        String   @unique
  holidayName        String
  date               String
  type               String
  applicableBranches String[] // branch codes
  description        String
  status             String // e.g., Active, Inactive
  addedBy            String
  remarks            String
  createdAt          DateTime @default(now())
}

model ExitReason {
  id           String   @id @default(cuid())
  reasonCode   String   @unique
  reasonName   String
  category     String // e.g. Resignation, Termination, Retirement, etc.
  description  String
  applicableTo String[] // e.g. ["Employees", "Contractors"]
  status       String // e.g. "Active", "Inactive"
  addedBy      String
  remarks      String
  createdAt    DateTime @default(now())
}

model LeaveType {
  id           String   @id @default(cuid())
  leaveCode    String   @unique
  leaveName    String
  category     String // e.g., Annual, Sick, Maternity, Paternity
  duration     Int // in days
  applicableTo String[] // e.g., ["Full-time", "Contract", "Intern"]
  description  String
  status       String // e.g., "Active", "Inactive"
  addedBy      String
  remarks      String
  createdAt    DateTime @default(now())
}

model PriorityLevel {
  id           String   @id @default(cuid())
  priorityCode String   @unique
  priorityName String
  level        Int // e.g., 1 for High, 2 for Medium, etc.
  category     String // e.g., Task, Request, Incident
  description  String
  status       String // "Active", "Inactive", etc.
  addedBy      String
  remarks      String
  createdAt    DateTime @default(now())
}

model ContractType {
  id           String   @id @default(cuid())
  contractCode String   @unique
  contractName String
  category     String // e.g., Employment, Consultancy, Internship
  duration     Int? // Duration in months or days (nullable)
  description  String
  status       String // e.g., "Active", "Inactive"
  addedBy      String
  remarks      String
  createdAt    DateTime @default(now())
}

model NonAttendanceReason {
  id           String   @id @default(cuid())
  reasonCode   String   @unique
  reasonName   String
  category     String // e.g., Medical, Personal, Emergency
  description  String
  applicableTo String[] // e.g., ["Employees", "Trainees"]
  status       String // e.g., "Active", "Inactive"
  addedBy      String
  remarks      String
  createdAt    DateTime @default(now())
}

model PositionRequisition {
  id                   String   @id @default(cuid())
  designation          String
  priority             String
  department           String
  contractType         String
  dueDate              DateTime
  numberOfPositions    Int
  status               String   @default("new")
  jobDescription       String   @db.Text
  reasonForRequisition String   @db.Text
  createdAt            DateTime @default(now())
}

model Candidate {
  id               String   @id @default(cuid())
  candidateCode    String   @unique
  firstName        String
  lastName         String
  email            String
  phone            String
  address          String
  city             String
  country          String
  applicationDate  DateTime
  coverLetter      String
  designation      String
  graduationYear   DateTime
  highestEducation String
  institution      String
  jobId            String
  resumeLink       String
  skills           String
  tools            String   @default("No tools")
  status           String
  workExperience   String
  createdAt        DateTime @default(now())
}

model LeaveApplication {
  id              String   @id @default(cuid())
  employeeId      String
  firstName       String
  lastName        String
  email           String
  address         String
  branch          String
  phone           String
  leaveType       String
  leaveBalance    Int
  applicationDate DateTime
  startDate       DateTime
  endDate         DateTime
  leaveDays       Int
  remarks         String?
  status          String   @default("Pending")
  approver        String?
  finalApprover   String?
  createdAt       DateTime @default(now())
}

model TrainingRequest {
  id             String   @id @default(uuid())
  requestDate    DateTime
  currentTime    String
  department     String
  areaOfTraining String
  targetGroup    String // store comma-separated user IDs
  budget         Float
  startDate      DateTime
  trainer        String?
  endDate        DateTime
  remarks        String?
  status         String?
  finalApprover  String?
  createdAt      DateTime @default(now())
}

model PerformanceEvaluation {
  id              String   @id @default(uuid())
  employeeId      String
  evaluationDate  DateTime
  evaluationTime  String
  department      String
  overallFeedback String
  goals           String
  status          String
  skills          Json
  createdAt       DateTime @default(now())

  // 👇 Add this line to define the relation
  employee User @relation(fields: [employeeId], references: [id])
}
