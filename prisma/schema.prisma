// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         String  @id @default(uuid())
  userName   String  @unique
  password   String
  firstName  String
  lastName   String
  shortName  String
  address    String
  email      String  @unique
  roleId     String
  branch     String
  phone1     String
  phone2     String
  description String? @default("No description")
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  messages Message[]
  profile Profile?
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?      @default("No description")
  permissions Permission[]
  users       User[]
}

model Permission {
  id     String @id @default(uuid())
  name   String
  value  Boolean @default(false)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId String
}




model Message {
  id        String   @id @default(uuid())
  file      String?
  chat      String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id             String   @id @default(uuid())
  profileName    String
  profileAbout String
  profilePicture String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Currency {
  id String @id @default(uuid()) 
    currencyName String
  currencySymbol String
  currencyCode String
  currencyFormat String
  decimalPlaces String
  thousandSeparator String
  KSHtoUSDExchange String
  allowedforTransactions Boolean
}

model BankName {
  id                String   @id @default(uuid())
  
  bankCode          String   @unique
  bankName          String
  branchName        String
  branchCode        String   @unique
  BICCode           String
  headOfficeAddress String
  country           String
  email             String   @unique
  phone1            String
  phone2            String
  website           String
  status            Boolean  @default(false)
  addedBy           String
  bankType          String
  remarks           String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
model Salesperson {
  id         String   @id @default(uuid())
  salesCode  String   @unique
  firstName  String
  lastName   String
  gender     String
  phone      String   @unique
  email      String   @unique
  address    String
  region     String
  status     Boolean  @default(false)
  addedBy    String
  remarks    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Branch {
  id            String   @id @default(uuid())
  branchCode    String   @unique
  name          String
  region        String
  town          String
  address       String
  phone         String
  email         String
  manager       String
  status        Boolean
  cycleDuration String
  remarks       String
  addedBy       String
  createdAt     DateTime @default(now())
}

model SalesArea {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  region       String
  county       String
  zone         String
  headquarters String
  areaManager  String
  phone        String
  email        String
  status       Boolean  @default(true)
  remarks      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
model PaymentTerm {
  id                       String    @id @default(cuid())
  name                     String
  description              String?
  totalDuration            Int
  numInstallments          Int
  installments             Json
  startDateRule            String
  gracePeriod              Int
  lateFeeEnabled           Boolean
  lateFeeType              String
  lateFeeAmount            Float
  lateFeeAfterDays         Int
  earlyDiscountEnabled     Boolean
  earlyDiscountPercent     Float
  earlyDiscountWithinDays  Int
  allowedMethods           String
  applicableTo             String  
  isActive                 Boolean   @default(true)
  notes                    String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model PaymentMethod {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  description    String?
  supportedTypes String // e.g., ["Cash", "Card", "Mobile Money"]
  isActive       Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SalesCategory {
  id                  String   @id @default(uuid())
  code                String   @unique
  name                String
  description         String?
  priceAdjustmentType String   // e.g., "percentage", "fixed"
  priceAdjustment     String
  allowCredit         Boolean
  creditLimit         String?
  defaultPaymentTerm  String?  // Reference payment term name or ID if normalized
  applicableChannels  String   // Comma-separated values like "online,retail"
  isActive            Boolean  @default(true)
  remarks             String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}



model Driver {
  id                 Int      @id @default(autoincrement())
  userName           String   @unique
  firstName          String
  lastName           String
  phoneNumber        String?
  email              String   @unique
  licenseNumber      String?
  licenseIssueDate  String?
  dateOfBirth        String?
  address            String?
  remarks            String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Vehicle {
  id                      String   @id @default(uuid())
  plateNumber             String
  make                    String
  model                   String
  yearOfManufacture       String
  status                  String
  fuelType                String
  capacity                String
  driver                  String
  assignedBranch          String
  purpose                 String
  remarks                 String
  initialOdometerReading  String
  ownershipType           String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Shift {
  id                  Int      @id @default(autoincrement())
  shiftName           String
  shiftCode           String   @unique
  startTime           String
  endTime             String
  shiftActiveDate     DateTime
  driver              String
  vehicle             String
  transportationItem  String
  startLocation       String
  endLocation         String
  wayPoint            String?
  isActive            String
  comment             String?
  customStartLocation String?
  customEndLocation   String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model VehicleCategory {

  id           Int     @id @default(autoincrement())
  categoryName String
  description  String
  type         String
  maxLoad      Float
  isActive     Boolean


  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model UnitOfMeasure {
  id               String   @id @default(uuid())
  unitName         String
  abbreviation     String
  description      String?
  conversionFactor Float
  isBaseUnit       Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ItemCategory {
  id             String   @id @default(uuid())
  categoryName   String
  categoryCode   String   @unique
  description    String?
  type           String
  unitOfMeasure  String
  tags           String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
model Item {
  id                    Int      @id @default(autoincrement())
  code                  String   @unique                // Unique item code
  name                  String                           // Item name
  category              String                           // Item category
  unitOfMeasure         String                           // Unit of measure (e.g., kg, piece)
  description           String?                          // Optional description
  excludeFromSale       Boolean  @default(false)         // Whether the item is excluded from sales
  excludeFromPurchase   Boolean  @default(false)         // Whether the item is excluded from purchases
  branch                String                           // Associated branch
  creator               String                           // Created by (user or system)
  status                String                           // e.g., "active", "inactive"
  barcode               String   @unique                 // Unique item barcode
  itemPrice             Float    @default(0)             // Base price of the item (with tax)
  priceBeforeTax        Float    @default(0)             // Price before tax
  taxAmount             Float    @default(0)             // Tax value derived from taxType
  discountWholesale     Float    @default(0)             // Discount for wholesale
  discountRetail        Float    @default(0)             // Discount for retail
  customDiscountAllowed Boolean  @default(false)         // Whether custom discounts are allowed
  taxType               String?                          // Optional tax type (e.g., VAT, None)
  createdAt             DateTime @default(now())         // Timestamp of creation
  updatedAt             DateTime @updatedAt              // Timestamp of last update
}




model Tax {
  id               String   @id @default(uuid())
  name             String
  code             String   @unique
  description      String?
  chargeType       String   // "Fixed" or "Percentage"
  lowerLimit       Float
  upperLimit       Float
  rate             Float
  fixedAmount      Float
  reliefApplicable Boolean
  effectiveFrom    DateTime
  branch           String
  creator          String
  status           String   // "Active" or "Inactive"
  createdAt        DateTime @default(now())
}
model Client {
  id                      String   @id @default(uuid())
  customerName            String
  customerInitials        String
  address                 String
  kraPin                  String
  currency                String
  isActive                Boolean
  phone1                  String
  phone2                  String
  email                   String
  bankName                String
  accountNumber           String
  salesPerson             String
  discountEliginility     Boolean
  branchName              String
  salesArea               String
  salesType               String
  comment                 String
  customerId              String
  preferedPaymentMethod   String
  sex                     String
  allowedDiscount         String
  creditLimit             String
  paymentTerms            String
  refNo                   String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

   salesQuotations         SalesQuotation[]
   directSales             DirectSale[]
   salesEntry              SalesEntry[]
}
model QuotationItem {
  id          String         @id @default(uuid())
  quotation   SalesQuotation @relation(fields: [quotationId], references: [id])
  quotationId String

  itemId      String?        // Add this if you're linking to a central item catalog
  itemName    String
  quantity    Int
  unitPrice   Float
  discount    Float?
  tax         Float?         // Optional: add this if you're using tax
  total       Float

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}


model SalesQuotation {
  id                  String          @id @default(uuid())
  quotationDate       DateTime        @default(now())
  client              Client          @relation(fields: [clientId], references: [id])
  clientId            String

  deliveryDetails     DeliveryDetail  @relation(fields: [deliveryDetailsId], references: [id])
  deliveryDetailsId   String          @unique   // ✅ Add this

  quotationItems      QuotationItem[]

  subtotal            Float
  shipping            Float
  grandTotal          Float
  remarks             String?
  status              String          @default("Pending")

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}


model DeliveryDetail {
  id            String   @id @default(uuid())
  address       String
  shiftId       String
  driverId      String
  vehicleId     String
  
 
  deliveryDate  DateTime

  // Optional additions based on frontend
  deliveryFrom  String?
  destination   String?
  customerReference String?
  comment       String?
  phoneNumber   String?
  accompaniedBy String?

  salesQuotation     SalesQuotation?
   directSale         DirectSale? 
   salesEntry  SalesEntry? 
}


model DirectSale {
  id                String             @id @default(uuid())
  saleDate          DateTime           @default(now())
  client            Client             @relation(fields: [clientId], references: [id])
  clientId          String

  deliveryDetails   DeliveryDetail     @relation(fields: [deliveryDetailsId], references: [id])
  deliveryDetailsId String             @unique

  saleItems         DirectSaleItem[]

  subtotal          Float
  shipping          Float
  grandTotal        Float
  remarks           String?
  status            String             @default("Completed")

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model DirectSaleItem {
  id           String       @id @default(uuid())
  directSale   DirectSale   @relation(fields: [directSaleId], references: [id])
  directSaleId String

  itemId       String?      // Optional: if referencing central catalog
  itemName     String
  quantity     Int
  unitPrice    Float
  discount     Float?
  tax          Float?
  total        Float

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}




model SalesEntry {
  id                String             @id @default(uuid())
  saleDate          DateTime           @default(now())

  client            Client             @relation(fields: [clientId], references: [id])
  clientId          String

  deliveryDetails   DeliveryDetail     @relation(fields: [deliveryDetailsId], references: [id])
  deliveryDetailsId String             @unique   // Only keep this if 1:1 relation is required

  salesEntryItems   SalesEntryItem[]   // ✅ corrected from saleEntryItems

  subtotal          Float
  shipping          Float
  grandTotal        Float
  remarks           String?
  status            String             @default("Completed")

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model SalesEntryItem {
  id           String       @id @default(uuid())

  salesEntry   SalesEntry   @relation(fields: [salesEntryId], references: [id]) // ✅ corrected field name
  salesEntryId String       // ✅ corrected from saleEntryId

  itemId       String?      // Optional: if referencing central catalog
  itemName     String
  quantity     Int
  unitPrice    Float
  discount     Float?
  tax          Float?
  total        Float

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}
